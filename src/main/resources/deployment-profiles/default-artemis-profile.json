{
  "id": "default-artemis-profile",
  "name": "Default Artemis Deployment Context",
  "version": "1.0.0",
  "status": "published",
  "editableBy": [
    "maintainer"
  ],
  "providedCapabilities": [
    "default-database",
    "default-authentication",
    "default-ci-provider",
    "pyris-service",
    "pyris-secret",
    "athena-service",
    "athena-secret",
    "hyperion-service",
    "lti-platform-registration",
    "theia-service",
    "apollon-conversion-service",
    "sharing-platform-registration",
    "sharing-secret"
  ],
  "parameters": {
    "database.type": "postgresql",
    "deployment.mode": "docker-compose",
    "ci.provider": "localci",
    "pyris.url": "https://pyris.example.com",
    "pyris.secretRef": "env:ARTEMIS_IRIS_SECRET_TOKEN",
    "pyris.rateLimit.defaultLimit": "-1",
    "pyris.rateLimit.defaultTimeframeHours": "-1",
    "athena.url": "http://localhost:5100",
    "athena.secretRef": "env:ARTEMIS_ATHENA_SECRET",
    "athena.restrictedModules": "module_text_llm,module_programming_llm",
    "athena.allowedFeedbackRequests": "10",
    "springAi.modelChat": "openai",
    "springAi.openAi.baseUrl": "https://endpoint.openai.azure.com",
    "springAi.openAi.apiKeyRef": "env:SPRING_AI_OPENAI_API_KEY",
    "springAi.openAi.microsoftFoundry": "true",
    "springAi.openAi.timeout": "5m",
    "springAi.openAi.chatModel": "gpt-5-mini",
    "springAi.openAi.temperature": "1.0",
    "springAi.chatMemory.maxMessages": "20",
    "springAi.retry.maxAttempts": "5",
    "springAi.retry.backoff.initialInterval": "1000ms",
    "springAi.retry.backoff.multiplier": "2.0",
    "springAi.retry.backoff.maxInterval": "30000ms",
    "llm.modelCosts.gpt-5-mini.inputCostPerMillionEur": "0.23",
    "llm.modelCosts.gpt-5-mini.outputCostPerMillionEur": "1.84",
    "atlas.chatModel": "gpt-5.4-mini",
    "atlas.temperature": "0.8",
    "atlas.orchestrator.model": "gpt-5.4",
    "atlas.orchestrator.temperature": "1.0",
    "atlas.orchestrator.reasoningEffort": "medium",
    "atlas.atlasml.enabled": "false",
    "atlas.atlasml.baseUrl": "https://atlasml.example.com",
    "atlas.atlasml.authTokenRef": "env:ARTEMIS_ATLASML_AUTH_TOKEN",
    "theia.portalUrl": "https://your-theia-instance.com",
    "theia.images.java.java17": "my-kubernetes-appdefinition",
    "apollon.conversionServiceUrl": "http://localhost:8080",
    "sharing.serverUrl": "https://search.sharing-codeability.uibk.ac.at/",
    "sharing.apiKeyRef": "env:ARTEMIS_SHARING_APIKEY",
    "sharing.actionName": "Export to Artemis@myUniversity",
    "server.publicUrl": "https://artemis.example.com",
    "lti.trustExternalSystems": "false",
    "lti.registrationMode": "manual-admin-db"
  },
  "unresolvedNotes": [
    "Profile values are prototype placeholders unless overridden by a maintainer-provided local profile.",
    "Spring AI settings are shared by Hyperion and Atlas; do not model them as Hyperion-only endpoint data.",
    "Athena admin docs still show a modules example, but current Artemis code/config uses restricted-modules.",
    "LTI platform registration is database-managed in Artemis and cannot be generated as a simple YAML property.",
    "AtlasML values are optional/future unless the feature model adds a dedicated AtlasML capability.",
    "Theia image mappings are environment-specific and may need structured profile values instead of dotted string keys.",
    "Sharing requires an API key issued for a reachable Artemis instance.",
    "Apollon maps apollon.conversionServiceUrl to artemis.apollon.conversion-service-url (application-artemis.yml:88-89); it requires the Modeling feature (apollon-requires-modeling constraint)."
  ]
}
