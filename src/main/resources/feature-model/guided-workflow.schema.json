{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artemis-feature-model.local/schema/guided-workflow.schema.json",
  "title": "Artemis Guided Feature Configuration Workflow",
  "type": "object",
  "required": [
    "workflow",
    "useCaseTemplates",
    "steps",
    "finalReviewGroups"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "workflow": {
      "$ref": "#/$defs/workflowMetadata"
    },
    "useCaseTemplates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/useCaseTemplate"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workflowStep"
      }
    },
    "finalReviewGroups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/finalReviewGroup"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "textList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "workflowMetadata": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "featureModelId",
        "featureModelVersion",
        "defaultTemplateId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "featureModelId": {
          "$ref": "#/$defs/id"
        },
        "featureModelVersion": {
          "type": "string",
          "minLength": 1
        },
        "defaultTemplateId": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "useCaseTemplate": {
      "type": "object",
      "required": [
        "id",
        "label",
        "description",
        "selectedFeatureIds",
        "deselectedFeatureIds",
        "recommendedStepIds",
        "consequences",
        "warnings"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "selectedFeatureIds": {
          "$ref": "#/$defs/textList"
        },
        "deselectedFeatureIds": {
          "$ref": "#/$defs/textList"
        },
        "recommendedStepIds": {
          "$ref": "#/$defs/textList"
        },
        "consequences": {
          "$ref": "#/$defs/textList"
        },
        "warnings": {
          "$ref": "#/$defs/textList"
        }
      }
    },
    "workflowStep": {
      "type": "object",
      "required": [
        "id",
        "title",
        "order",
        "description",
        "decisions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/guidedDecision"
          }
        }
      }
    },
    "guidedDecision": {
      "type": "object",
      "required": [
        "id",
        "question",
        "description",
        "selectionMode",
        "reviewGroupId",
        "options"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "selectionMode": {
          "enum": [
            "single",
            "multiple"
          ]
        },
        "reviewGroupId": {
          "$ref": "#/$defs/id"
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/decisionOption"
          }
        }
      }
    },
    "decisionOption": {
      "type": "object",
      "required": [
        "id",
        "label",
        "description",
        "selects",
        "deselects",
        "requiresCapabilities",
        "consequences",
        "artifactImpacts",
        "enabledOutcome",
        "recommendedWhen",
        "thingsToKnow",
        "warnings"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "selects": {
          "$ref": "#/$defs/textList"
        },
        "deselects": {
          "$ref": "#/$defs/textList"
        },
        "requiresCapabilities": {
          "$ref": "#/$defs/textList"
        },
        "consequences": {
          "$ref": "#/$defs/textList"
        },
        "artifactImpacts": {
          "$ref": "#/$defs/textList"
        },
        "enabledOutcome": {
          "$ref": "#/$defs/textList"
        },
        "recommendedWhen": {
          "$ref": "#/$defs/textList"
        },
        "thingsToKnow": {
          "$ref": "#/$defs/textList"
        },
        "warnings": {
          "$ref": "#/$defs/textList"
        }
      }
    },
    "finalReviewGroup": {
      "type": "object",
      "required": [
        "id",
        "title",
        "order",
        "featureIds"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "featureIds": {
          "$ref": "#/$defs/textList"
        }
      }
    }
  }
}
